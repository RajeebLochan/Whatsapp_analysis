# Copy to .env (never commit .env) or set these as environment variables / Streamlit secrets.
# Placeholder values only.

# Optional: enables the AI summary feature with a deployment-wide key.
# Shared keys are ignored unless WA_ENABLE_SHARED_AI_KEY=true (see README "AI summaries").
TOGETHER_API_KEY=replace-with-your-key
WA_ENABLE_SHARED_AI_KEY=false
