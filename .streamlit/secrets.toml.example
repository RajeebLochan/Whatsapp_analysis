# Copy to .streamlit/secrets.toml (git-ignored) or paste into your hosting provider's secrets UI.
# Placeholder values only — never commit real keys.

# Optional deployment-wide key. Ignored unless WA_ENABLE_SHARED_AI_KEY = "true".
# Only enable it when the provider account has spending limits and the app has access control.
TOGETHER_API_KEY = "replace-with-your-key"
WA_ENABLE_SHARED_AI_KEY = "false"

# Let visitors paste their own key for the current session (default "true").
WA_ALLOW_USER_AI_KEY = "true"

# Comma-separated model IDs offered in the UI. Verify against
# https://docs.together.ai/docs/serverless/models before deploying.
WA_TOGETHER_MODELS = "openai/gpt-oss-120b,openai/gpt-oss-20b"

# Maximum provider HTTP requests per browser session.
WA_AI_MAX_REQUESTS_PER_SESSION = "6"
